BIGIBOT_MODEL=github-copilot/gpt-5.3-codex
BIGIBOT_AGENT=BigiBot
BIGIBOT_FALLBACK_MODE=false

# Caveman proxy routing
BIGIBOT_CAVEMAN_ENABLED=false
BIGIBOT_CAVEMAN_AUTOSTART=false
BIGIBOT_CAVEMAN_URL=http://127.0.0.1:8787
BIGIBOT_CAVEMAN_PROVIDER=openai
BIGIBOT_CAVEMAN_BASE_URL=
BIGIBOT_CAVEMAN_MODE=compress
BIGIBOT_CAVEMAN_CONFIG=

# Optional chat output clamp
BIGIBOT_MAX_RESPONSE_CHARS=2200
